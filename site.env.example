# Site config: copy to site.env (gitignored) and edit. Every script sources it (set -a).
# $WORK = persistent (code, envs, weights). $SCRATCH = bulk data + outputs, purged ~30 days untouched.

# Jean Zay project: jobs use --account=${SR_PROJECT}@h100 / @a100 / @v100.
SR_PROJECT=xyz

# Unzipped data (scripts/unpack_data.sh). Layout:
#   ${SR_DATA}/mixes/vqa_train_190k_es_clean.jsonl      190,000 rows, video paths relative to SR_VSI590K
#   ${SR_DATA}/mixes/simplesr_train_traces.jsonl        145,647 rows (reasoning extension)
#   ${SR_DATA}/VSI-590K/<source>/<scene>/det_es/frames/frameNN.jpg
#   ${SR_DATA}/vsibench/{arkitscenes,scannet,scannetpp}/<scene>.mp4   (VSI-Bench eval videos)
SR_DATA=$SCRATCH/sr_vggt_data
SR_MIX_190K=$SR_DATA/mixes/vqa_train_190k_es_clean.jsonl
SR_MIX_TRACES=$SR_DATA/mixes/simplesr_train_traces.jsonl
SR_VSI590K=$SR_DATA/VSI-590K
SR_VSIBENCH=$SR_DATA/vsibench

# VGGT feature caches (scripts/export_vggt.sh), one dir per configs/caches/*.env. ~0.3-1.5 TB each.
SR_CACHE_ROOT=$SCRATCH/sr_vggt_caches

# HF_HOME: model weights + the VSI-Bench question table (scripts/download_weights.sh). Must be on
# $WORK: compute nodes are offline, and each cache entry stamps the VGGT weight path inside it.
SR_HF_HOME=$WORK/sr_vggt_hf

# Python venvs, one per GPU kind: ${SR_ENV_ROOT}/{h100,a100,v100} (scripts/setup_env.sh).
SR_ENV_ROOT=$WORK/sr_vggt_envs

# Run dirs: ${SR_OUTPUT_ROOT}/sr_vggt_<experiment>/checkpoint-N, smoke runs in _smoke_sr_vggt_<experiment>.
SR_OUTPUT_ROOT=$SCRATCH/sr_vggt_results
SR_LOG_DIR=$WORK/sr_vggt_logs
