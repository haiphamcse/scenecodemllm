# Site config: copy to site.env (gitignored) and edit. Every script sources it (set -a).
# $WORK = persistent (code, envs, weights). $SCRATCH = bulk data + outputs, purged ~30 days untouched.

# Jean Zay project: jobs use --account=${SR_PROJECT}@h100 / @a100.
SR_PROJECT=xyz

# VSI-590K root: the training mixes in data/ name videos relative to it
# (<root>/{arkitscenes,scannet,scannetppv2}/<scene>.mp4; 4,878 videos, ~132 GB).
SR_VSI590K=$SCRATCH/VSI-590K

# Local copy of the nyu-visionx/VSI-Bench dataset repo with its three video zips unzipped in
# place (README.md "VSI-Bench"): README.md, test*.parquet, {arkitscenes,scannet,scannetpp}/*.mp4.
SR_VSIBENCH=$SCRATCH/VSI-Bench

# HF_HOME: model weights (scripts/download_weights.sh). On $WORK: compute nodes are offline.
SR_HF_HOME=$WORK/sr_vggt_hf

# Python venvs, one per GPU kind: ${SR_ENV_ROOT}/{h100,a100} (scripts/setup_env.sh).
SR_ENV_ROOT=$WORK/sr_vggt_envs

# Run dirs: ${SR_OUTPUT_ROOT}/sr_vggt_<experiment>/checkpoint-N, smoke runs in _smoke_sr_vggt_<experiment>.
SR_OUTPUT_ROOT=$SCRATCH/sr_vggt_results
SR_LOG_DIR=$WORK/sr_vggt_logs
