# lora128: main with one change, LoRA r128/a256 (the fork's code is byte-identical to main's).
# Original: idea_3i_190k_es_64f_lat512_lora128 (VSI-Bench full @743: 0.6059).
CACHE=es
MIX=190k
MODEL_ARGS=(--model_name_or_path Qwen/Qwen3-VL-2B-Instruct --arch perceiver --prompt clean
  --frame_num_latents 512 --camera_num_latents 32 --frame_widening_factor 2)
TRAIN_ARGS=(--learning_rate 1e-4 --lora_r 128 --lora_alpha 256 --dataloader_num_workers 8)
EVAL_ARGS=(--max_new_tokens 16)
