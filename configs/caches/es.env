# VGGT-Omega 512 checkpoint (not text-aligned), last layer, det_es frames balanced-resized to 256.
# Used by: main, lora128, vlm3r. Original: $SCRATCH/dataset/vggt_cache_256_64f_es (stored fp32 there;
# bf16 here gives the same training inputs, since the model casts to bf16 anyway).
CACHE_DIR=vggt_cache_256_64f_es
CACHE_ARGS=(--vggt_backbone omega --vggt_repo facebook/VGGT-Omega --vggt_file vggt_omega_1b_512.pt
  --vggt_revision 05654241adc2f218dfb089c373a011f8a7040576
  --vggt_frames balanced --vggt_image_resolution 256 --video_fps 1.0 --video_max_frames 64)
