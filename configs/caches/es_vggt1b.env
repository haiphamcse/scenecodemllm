# Original VGGT-1B aggregator (patch 14, 1 camera + 4 register tokens), last layer, det_es frames
# balanced-resized to 256 (210x308 -> 330 patches). Used by: vggt1b.
# Original: $SCRATCH/dataset/vggt_cache_256_64f_es_vggt1b (bf16).
CACHE_DIR=vggt_cache_256_64f_es_vggt1b
CACHE_ARGS=(--vggt_backbone vggt1b --vggt_repo facebook/VGGT-1B --vggt_file model.safetensors
  --vggt_revision 860abec7937da0a4c03c41d3c269c366e82abdf9
  --vggt_frames balanced --vggt_image_resolution 256 --video_fps 1.0 --video_max_frames 64)
