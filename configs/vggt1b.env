# vggt1b: main with two changes: the original VGGT-1B aggregator instead of VGGT-Omega
# (patch 14, 5 camera/register tokens per frame) and the descriptive text256 prompt, because
# the original fork was copied from text256. Model code unchanged.
# Original: idea_3i_190k_es_64f_lat512_vggt1b (trained to 743, never evaluated).
#   (trained on det_es frames + cached VGGT features: not directly comparable)
VGGT_ARGS=(--vggt_backbone vggt1b --vggt_repo facebook/VGGT-1B --vggt_file model.safetensors
  --vggt_revision 860abec7937da0a4c03c41d3c269c366e82abdf9
  --vggt_frames balanced --vggt_image_resolution 256 --video_fps 1.0 --video_max_frames 64)
MIX=190k
MODEL_ARGS=(--model_name_or_path Qwen/Qwen3-VL-2B-Instruct --arch perceiver --prompt text256
  --frame_num_latents 512 --camera_num_latents 32 --frame_widening_factor 2)
TRAIN_ARGS=(--learning_rate 1e-4 --lora_r 64 --lora_alpha 128 --dataloader_num_workers 8)
EVAL_ARGS=(--max_new_tokens 16)
