# vggt1b: main with two changes: the original VGGT-1B aggregator instead of VGGT-Omega (cache
# es_vggt1b: patch 14, 5 camera/register tokens per frame) and the descriptive text256 prompt,
# because the original fork was copied from text256. Model code unchanged.
# Original: idea_3i_190k_es_64f_lat512_vggt1b (trained to 743, never evaluated).
CACHE=es_vggt1b
MIX=190k
MODEL_ARGS=(--model_name_or_path Qwen/Qwen3-VL-2B-Instruct --arch perceiver --prompt text256
  --frame_num_latents 512 --camera_num_latents 32 --frame_widening_factor 2)
TRAIN_ARGS=(--learning_rate 1e-4 --lora_r 64 --lora_alpha 128 --dataloader_num_workers 8)
EVAL_ARGS=(--max_new_tokens 16)
