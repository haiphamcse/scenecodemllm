# text256: main with exactly two changes: the text-aligned VGGT-Omega checkpoint
# (vggt_omega_1b_256_text.pt) and the descriptive prompt that names the two VGGT
# inputs ("Per-frame geometry features: ... Camera and scene features: ...").
# Base of the 4b / lat3072 ablations and of the reason16k extension.
# Original: idea_3i_190k_es_64f_lat512_text256 (VSI-Bench full @743: 0.6060).
#   (trained on det_es frames + cached VGGT features: not directly comparable)
VGGT_ARGS=(--vggt_backbone omega --vggt_repo facebook/VGGT-Omega --vggt_file vggt_omega_1b_256_text.pt
  --vggt_revision 05654241adc2f218dfb089c373a011f8a7040576
  --vggt_frames balanced --vggt_image_resolution 256 --video_fps 1.0 --video_max_frames 64)
MIX=190k
MODEL_ARGS=(--model_name_or_path Qwen/Qwen3-VL-2B-Instruct --arch perceiver --prompt text256
  --frame_num_latents 512 --camera_num_latents 32 --frame_widening_factor 2)
TRAIN_ARGS=(--learning_rate 1e-4 --lora_r 64 --lora_alpha 128 --dataloader_num_workers 8)
EVAL_ARGS=(--max_new_tokens 16)
