# reason16k: continue the text256 ablation (not main) on SimpleSR reasoning traces
# (extensions/reasoning.py). First window
# loads text256's checkpoint-743 adapter (LoRA + Perceivers) with a fresh optimizer, lr 5e-5, 3%
# warmup + cosine, 1 epoch; rows over 16,384 tokens are dropped (none are: longest 16,090);
# 569 steps. Eval generates up to 8,192 tokens and scores the text after the last "Answer:".
# Original: idea_3i_190k_es_64f_lat512_text256_reason_cont_16k (VSI-Bench debiased @569: 0.3381).
#   (trained on det_es frames + cached VGGT features: not directly comparable)
VGGT_ARGS=(--vggt_backbone omega --vggt_repo facebook/VGGT-Omega --vggt_file vggt_omega_1b_256_text.pt
  --vggt_revision 05654241adc2f218dfb089c373a011f8a7040576
  --vggt_frames balanced --vggt_image_resolution 256 --video_fps 1.0 --video_max_frames 64)
MIX=traces
INIT_FROM=sr_vggt_text256/checkpoint-743   # under $SR_OUTPUT_ROOT; override with INIT_CKPT=<dir>
MODEL_ARGS=(--model_name_or_path Qwen/Qwen3-VL-2B-Instruct --arch perceiver --prompt reason
  --frame_num_latents 512 --camera_num_latents 32 --frame_widening_factor 2)
TRAIN_ARGS=(--learning_rate 5e-5 --lora_r 64 --lora_alpha 128 --dataloader_num_workers 8
  --max_seq_len 16384)
EVAL_ARGS=(--max_new_tokens 8192)
EVAL_PARTS=4   # split a timed-out shard's leftover rows over 4 more jobs
