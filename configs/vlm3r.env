# vlm3r: VLM-3R cross-attention fusion (ablations/vlm3r.py): Qwen's video embeddings attend to
# per-frame VGGT-Omega 512 (camera + patch) tokens, zero-init residual. No placeholders.
# Original: idea_3i_190k_es_64f_vlm3r (VSI-Bench full @743: 0.6013).
CACHE=es
MIX=190k
MODEL_ARGS=(--model_name_or_path Qwen/Qwen3-VL-2B-Instruct --arch vlm3r --prompt plain
  --fusion_num_heads 16 --fusion_dropout 0.1)
TRAIN_ARGS=(--learning_rate 1e-4 --lora_r 64 --lora_alpha 128 --dataloader_num_workers 8)
EVAL_ARGS=(--max_new_tokens 16)
