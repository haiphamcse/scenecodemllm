# vlm3r: VLM-3R cross-attention fusion (sr_vggt/ablations.py): Qwen's video embeddings attend to
# per-frame VGGT-Omega 512 (camera + patch) tokens, zero-init residual. Differs from main in the
# fusion (no Perceiver) and the prompt (plain: no placeholders); same VGGT input as main.
# Original: idea_3i_190k_es_64f_vlm3r (VSI-Bench full @743: 0.6013).
#   (trained on det_es frames + cached VGGT features: not directly comparable)
VGGT_ARGS=(--vggt_backbone omega --vggt_repo facebook/VGGT-Omega --vggt_file vggt_omega_1b_512.pt
  --vggt_revision 05654241adc2f218dfb089c373a011f8a7040576
  --vggt_frames balanced --vggt_image_resolution 256 --video_fps 1.0 --video_max_frames 64)
MIX=190k
MODEL_ARGS=(--model_name_or_path Qwen/Qwen3-VL-2B-Instruct --arch vlm3r --prompt plain
  --fusion_num_heads 16 --fusion_dropout 0.1)
TRAIN_ARGS=(--learning_rate 1e-4 --lora_r 64 --lora_alpha 128 --dataloader_num_workers 8)
EVAL_ARGS=(--max_new_tokens 16)
