# Main (lat512): Qwen3-VL-2B + VGGT-Omega 512 features -> frame Perceiver (512 latents) + camera
# Perceiver (32 latents) scattered into <|quad_start|>/<|quad_end|> placeholders, short "clean"
# prompt; LoRA r64/a128; 190k clean mix on det_es frames; 743 steps at global batch 256.
# Original: idea_3i_190k_es_64f_lat512_clean (VSI-Bench full @743: 0.6000).
CACHE=es
MIX=190k
MODEL_ARGS=(--model_name_or_path Qwen/Qwen3-VL-2B-Instruct --arch perceiver --prompt clean
  --frame_num_latents 512 --camera_num_latents 32 --frame_widening_factor 2)
TRAIN_ARGS=(--learning_rate 1e-4 --lora_r 64 --lora_alpha 128 --dataloader_num_workers 8)
EVAL_ARGS=(--max_new_tokens 16)
