# lat3072: main with 3072 frame latents (= Qwen's video token count for a 64-frame 384x256 clip).
# Original: idea_3i_190k_es_64f_lat3072_text256 (VSI-Bench full @743: 0.6117, A100 bf16).
CACHE=es_text
MIX=190k
MODEL_ARGS=(--model_name_or_path Qwen/Qwen3-VL-2B-Instruct --arch perceiver --prompt text256
  --frame_num_latents 3072 --camera_num_latents 32 --frame_widening_factor 2)
TRAIN_ARGS=(--learning_rate 1e-4 --lora_r 64 --lora_alpha 128 --dataloader_num_workers 8)
EVAL_ARGS=(--max_new_tokens 16)
