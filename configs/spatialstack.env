# spatialstack: SpatialStack layered fusion (sr_vggt/ablations.py): VGGT-Omega 512 layers
# 11/17/23 -> zero-init mergers -> added into Qwen's deepstack slots at decoder layers 0/1/2.
# Differs from main in the fusion (no Perceiver) and the prompt (plain: main's short prompt without
# placeholders); same VGGT-Omega 512 checkpoint, run on Qwen's own pixels (--vggt_frames native).
# Original: idea_3i_190k_es_64f_spatialstack (VSI-Bench full @743: 0.6208).
#   (trained on det_es frames + cached VGGT features: not directly comparable)
VGGT_ARGS=(--vggt_backbone omega --vggt_repo facebook/VGGT-Omega --vggt_file vggt_omega_1b_512.pt
  --vggt_revision 05654241adc2f218dfb089c373a011f8a7040576
  --vggt_frames native --vggt_layers 11 17 23 --video_fps 1.0 --video_max_frames 64)
MIX=190k
MODEL_ARGS=(--model_name_or_path Qwen/Qwen3-VL-2B-Instruct --arch spatialstack --prompt plain
  --geometry_encoder_layers 11 17 23 --geometry_fusion_layers 0 1 2 --merger_hidden_dim 4096)
TRAIN_ARGS=(--learning_rate 1e-4 --lora_r 64 --lora_alpha 128 --dataloader_num_workers 8)
EVAL_ARGS=(--max_new_tokens 16)
